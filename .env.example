# Copy to .env and edit. Every line is optional.

# ---- Claude access -------------------------------------------------------
# With no key set, the Claude Agent SDK uses the Claude Code login on this machine.
# ANTHROPIC_API_KEY=sk-ant-...
# Amazon Bedrock / Google Vertex AI also work through the usual Claude Code variables:
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# Model for the live interviewer (fast) and for reviews and the problem workshop (strong).
# LIVE_MODEL=sonnet
# DEEP_MODEL=opus

# ---- Server --------------------------------------------------------------
# PORT=4477
# HOST=127.0.0.1
# Where problems, sessions, prompts and models are stored.
# Default: the repository when run from a git clone, otherwise ~/.hotseat-ai
# HOTSEAT_HOME=/path/to/data

# ---- Judge ---------------------------------------------------------------
# CXX=g++
# PYTHON=python3

# ---- Interviewer pacing (milliseconds) -----------------------------------
# IDLE_MS=30000        pause after an edit before the interviewer is woken
# STALL_MS=240000      no edits for this long counts as being stuck
# MIN_GAP_MS=45000     minimum gap between two non-urgent wake-ups
# VOICE_GAP_MS=6000    minimum gap between wake-ups caused only by speech

# ---- Speech-to-text (optional; run "npm run setup:voice") -----------------
# WHISPER_SERVER=whisper-server
# WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_PORT=4478

# ---- Text-to-speech ------------------------------------------------------
# edge   : Microsoft Edge's read-aloud endpoint. Free, unofficial, needs internet. (default)
# openai : any service with an OpenAI-compatible /audio/speech endpoint
# say    : the macOS "say" command, fully local
# off    : text only
# TTS_PROVIDER=edge
# TTS_VOICE_EN=en-US-AvaNeural
# TTS_VOICE_ZH=zh-CN-YunxiNeural
# TTS_OPENAI_BASE_URL=https://api.openai.com/v1
# TTS_OPENAI_API_KEY=
# TTS_OPENAI_MODEL=gpt-4o-mini-tts
