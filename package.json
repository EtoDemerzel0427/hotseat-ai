{
  "name": "hotseat-ai",
  "version": "0.1.0",
  "description": "An AI interviewer that watches you code: local mock coding interviews run by Claude, with a local judge, voice, and a review of your full edit history.",
  "scripts": {
    "start": "node bin/cli.mjs --no-open",
    "open": "node bin/cli.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "check": "node scripts/check-problem.mjs"
  },
  "keywords": [
    "mock-interview",
    "coding-interview",
    "claude",
    "llm",
    "ai",
    "interview-practice",
    "whisper",
    "monaco"
  ],
  "author": "EtoDemerzel0427",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "marked": "^18.2.0",
    "monaco-editor": "^0.52.2",
    "msedge-tts": "^2.1.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "hotseat-ai": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "files": [
    "bin",
    "server",
    "scripts",
    "public",
    "problems",
    "prompts",
    ".env.example",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EtoDemerzel0427/hotseat-ai.git"
  },
  "homepage": "https://github.com/EtoDemerzel0427/hotseat-ai#readme"
}
